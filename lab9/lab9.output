Grammar

    0 $accept: Program $end

    1 Program: Declaration_List

    2 Declaration_List: Declaration
    3                 | Declaration Declaration_List

    4 Declaration: Var_Declaration
    5            | Fun_Declaration

    6 Var_Declaration: Type_Specifier Var_List ';'

    7 Var_List: T_ID
    8         | T_ID '[' T_NUM ']'
    9         | T_ID ',' Var_List
   10         | T_ID '[' T_NUM ']' ',' Var_List

   11 Type_Specifier: T_INT
   12               | T_BOOLEAN
   13               | T_VOID

   14 $@1: ε

   15 $@2: ε

   16 Fun_Declaration: Type_Specifier T_ID '(' $@1 Params ')' $@2 Compound_Stmt

   17 Params: T_VOID
   18       | Param_List

   19 Param_List: Param
   20           | Param ',' Param_List

   21 Param: Type_Specifier T_ID
   22      | Type_Specifier T_ID '[' ']'

   23 $@3: ε

   24 Compound_Stmt: T_BEGIN $@3 Local_Declarations Statement_List T_END

   25 Local_Declarations: Var_Declaration Local_Declarations
   26                   | ε

   27 Statement_List: ε
   28               | Statement Statement_List

   29 Statement: Expression_Stmt
   30          | Compound_Stmt
   31          | Selection_Stmt
   32          | Iteration_Stmt
   33          | Assignment_Stmt
   34          | Return_Stmt
   35          | Read_Stmt
   36          | Write_Stmt

   37 Expression_Stmt: Expr ';'
   38                | ';'

   39 Selection_Stmt: T_IF Expr T_THEN Statement T_ENDIF
   40               | T_IF Expr T_THEN Statement T_ELSE Statement T_ENDIF

   41 Iteration_Stmt: T_WHILE Expr T_DO Statement

   42 Assignment_Stmt: VARIABLE '=' Expr ';'

   43 Return_Stmt: T_RETURN Expr ';'
   44            | T_RETURN ';'

   45 Write_Stmt: T_WRITE Expr ';'

   46 Read_Stmt: T_READ VARIABLE ';'

   47 VARIABLE: T_ID
   48         | T_ID '[' Expr ']'

   49 Expr: Simple_Expression

   50 Simple_Expression: Additive_Expression
   51                  | Simple_Expression Rel_Op Additive_Expression

   52 Rel_Op: T_LE
   53       | T_LT
   54       | T_GT
   55       | T_GE
   56       | T_EQ
   57       | T_NE

   58 Additive_Expression: Term
   59                    | Additive_Expression Add_Op Term

   60 Add_Op: '+'
   61       | '-'

   62 Term: Factor
   63     | Term Mult_Op Factor

   64 Mult_Op: '*'
   65        | '/'
   66        | T_AND
   67        | T_OR

   68 Factor: '(' Expr ')'
   69       | T_NUM
   70       | T_STRING
   71       | VARIABLE
   72       | CALL
   73       | T_NOT Factor
   74       | T_FALSE
   75       | T_TRUE

   76 CALL: T_ID '(' Args ')'

   77 Args: Arg_list
   78     | ε

   79 Arg_list: Expr ',' Arg_list
   80         | Expr


